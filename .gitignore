*.pyc
.venv/
/env/
.pytest_cache/

# Training artifacts (never tracked; benchmarks/ci_baseline/*.json — the
# committed CI regression reference — is NOT under these paths and stays in)
models/
logs/

# Vendored binary drops & archives
libtorch/
*.zip
*.tar.gz

# Raw working notes (official docs live in docs/ and the root
# README.md / experiments.md / research_state.md)
